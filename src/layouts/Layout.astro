---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ogDefault from "../img/Logo.avif";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  canonicalUrl?: string;
  hideWhatsApp?: boolean;
}

const {
  title = "Agencias Nacionales S.A.S | Uniformes y Calzado Industrial",
  description = "Uniformes y calzado industrial diseñados para la seguridad, comodidad y durabilidad que tu equipo necesita.",
  image = ogDefault.src,
  noindex = false,
  ogType = "website",
  canonicalUrl,
  hideWhatsApp = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://agenciasnacionales.com");
const canonical = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Agencias Nacionales S.A.S",
  url: siteUrl.href,
  logo: new URL(ogDefault.src, siteUrl).href,
  email: "contactanos@agenciasnacionales.com",
  telephone: "+573042351036",
  address: {
    "@type": "PostalAddress",
    addressCountry: "CO",
  },
};
---

<!doctype html>
<html lang="es" class="w-full">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-CL9SSCWWDM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      // Snippet tal cual lo entrega Google. No hace falta enviar page_view a
      // mano en astro:page-load aunque usemos <ClientRouter />: la medicion
      // mejorada de GA4 ya cuenta las navegaciones por History API, con el
      // title correcto. Hacerlo a mano duplica cada vista (medido: 7 en vez
      // de 4). Si alguna vez se apaga "cambios de pagina basados en eventos
      // del historial" en el stream de GA4, ahi si haria falta.
      gtag("config", "G-CL9SSCWWDM");
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/avif" href="/Icon.avif?v=2" />
    <link rel="shortcut icon" href="/Icon.avif?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Agencias Nacionales S.A.S" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    <slot name="head" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="w-full bg-white text-gray-800 antialiased">
    <slot />
    {!hideWhatsApp && <WhatsAppFloat />}
    <script is:inline>
      (() => {
        const adjustHeaderOffset = () => {
          const header = document.querySelector("header");
          document.body.style.paddingTop = header ? `${header.offsetHeight}px` : "";
        };

        adjustHeaderOffset();
        window.addEventListener("resize", adjustHeaderOffset);
        document.addEventListener("astro:page-load", adjustHeaderOffset);
        document.addEventListener("astro:after-swap", adjustHeaderOffset);
        document.fonts?.ready.then(adjustHeaderOffset);
      })();
    </script>
  </body>
</html>

