---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ogDefault from "../img/Logo.avif";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { EMAIL, WHATSAPP_NUMBER } from "../data/contact";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  canonicalUrl?: string;
  hideWhatsApp?: boolean;
}

const {
  title = "Dotación Empresarial en Medellín | Agencias Nacionales",
  description = "Fabricamos dotación empresarial en Medellín: uniformes de trabajo, calzado de seguridad y EPP personalizados para empresas en Antioquia y Colombia.",
  image = ogDefault.src,
  noindex = false,
  ogType = "website",
  canonicalUrl,
  hideWhatsApp = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://agenciasnacionales.com");
const canonical = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const organization = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "@id": `${siteUrl.href}#business`,
  name: "Agencias Nacionales S.A.S",
  description:
    "Fabricante y proveedor colombiano de dotaciones empresariales, uniformes de trabajo, calzado de seguridad y elementos de protección personal.",
  url: siteUrl.href,
  logo: new URL(ogDefault.src, siteUrl).href,
  image: new URL(ogDefault.src, siteUrl).href,
  email: EMAIL,
  telephone: `+${WHATSAPP_NUMBER}`,
  taxID: "890903993-3",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Carrera 47 #20 Sur-7, Bosques de Zúñiga",
    addressLocality: "Envigado",
    addressRegion: "Antioquia",
    postalCode: "055422",
    addressCountry: "CO",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 6.1753942,
    longitude: -75.5905534,
  },
  areaServed: [
    { "@type": "City", name: "Medellín" },
    { "@type": "City", name: "Envigado" },
    { "@type": "AdministrativeArea", name: "Antioquia" },
    { "@type": "Country", name: "Colombia" },
  ],
  sameAs: [
    "https://www.instagram.com/agencias_nacionales",
    "https://www.linkedin.com/company/agencias-nacionales/",
    "https://www.facebook.com/profile.php?id=61566851084986",
  ],
  knowsAbout: [
    "Dotaciones empresariales",
    "Uniformes de trabajo",
    "Calzado de seguridad",
    "Elementos de protección personal",
    "Uniformes hospitalarios",
  ],
};
---

<!doctype html>
<html lang="es" class="w-full">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-VYZ3Q9LL82"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      // Snippet tal cual lo entrega Google. No hace falta enviar page_view a
      // mano en astro:page-load aunque usemos <ClientRouter />: la medicion
      // mejorada de GA4 ya cuenta las navegaciones por History API, con el
      // title correcto. Hacerlo a mano duplica cada vista (medido: 7 en vez
      // de 4). Si alguna vez se apaga "cambios de pagina basados en eventos
      // del historial" en el stream de GA4, ahi si haria falta.
      gtag("config", "G-VYZ3Q9LL82");
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/avif" href="/Icon.avif?v=2" />
    <link rel="shortcut icon" href="/Icon.avif?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Agencias Nacionales S.A.S" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    <slot name="head" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="w-full bg-white text-gray-800 antialiased">
    <slot />
    {!hideWhatsApp && <WhatsAppFloat />}
    <script is:inline>
      (() => {
        const adjustHeaderOffset = () => {
          const header = document.querySelector("header");
          document.body.style.paddingTop = header ? `${header.offsetHeight}px` : "";
        };

        adjustHeaderOffset();
        window.addEventListener("resize", adjustHeaderOffset);
        document.addEventListener("astro:page-load", adjustHeaderOffset);
        document.addEventListener("astro:after-swap", adjustHeaderOffset);
        document.fonts?.ready.then(adjustHeaderOffset);

        if (!window.__agenciasLeadTrackingBound) {
          window.__agenciasLeadTrackingBound = true;
          document.addEventListener("click", (event) => {
            const link = event.target.closest?.('a[href*="wa.me/"]');
            if (!link) return;
            window.gtag?.("event", "generate_lead", {
              method: "whatsapp",
              link_url: link.href,
            });
          });
        }
      })();
    </script>
  </body>
</html>
