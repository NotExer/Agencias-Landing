---
import "../styles/global.css";
import { SEO_METADATA } from "../data/seo";
import { ClientRouter } from "astro:transitions";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import ogDefault from "../img/Logo.avif";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { EMAIL, WHATSAPP_NUMBER } from "../data/contact";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  canonicalUrl?: string;
  hideWhatsApp?: boolean;
}

const {
  title: requestedTitle = "Dotación Empresarial en Medellín | Agencias Nacionales",
  description: requestedDescription = "Fabricamos dotación empresarial en Medellín: uniformes de trabajo, calzado de seguridad y EPP personalizados para empresas en Antioquia y Colombia.",
  image = ogDefault.src,
  noindex = false,
  ogType = "website",
  canonicalUrl,
  hideWhatsApp = false,
} = Astro.props;

const metadata = SEO_METADATA[Astro.url.pathname];
const title = metadata?.title ?? requestedTitle;
const description = metadata?.description ?? requestedDescription;

const siteUrl = Astro.site ?? new URL("https://agenciasnacionales.com");
const canonical = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const organization = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "@id": `${siteUrl.href}#business`,
  name: "Agencias Nacionales S.A.S",
  description:
    "Fabricante y proveedor colombiano de dotaciones empresariales, uniformes de trabajo, calzado de seguridad y elementos de protección personal.",
  url: siteUrl.href,
  logo: new URL(ogDefault.src, siteUrl).href,
  image: new URL(ogDefault.src, siteUrl).href,
  email: EMAIL,
  telephone: `+${WHATSAPP_NUMBER}`,
  taxID: "890903993-3",
  foundingDate: "1969",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Carrera 47 #20 Sur-7, Bosques de Zúñiga",
    addressLocality: "Envigado",
    addressRegion: "Antioquia",
    postalCode: "055422",
    addressCountry: "CO",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 6.1753942,
    longitude: -75.5905534,
  },
  areaServed: [
    { "@type": "City", name: "Medellín" },
    { "@type": "City", name: "Envigado" },
    { "@type": "AdministrativeArea", name: "Antioquia" },
    { "@type": "Country", name: "Colombia" },
  ],
  sameAs: [
    "https://www.instagram.com/agencias_nacionales",
    "https://www.linkedin.com/company/agencias-nacionales/",
    "https://www.facebook.com/profile.php?id=61566851084986",
  ],
  knowsAbout: [
    "Dotaciones empresariales",
    "Uniformes de trabajo",
    "Calzado de seguridad",
    "Calzado de dotación",
    "Elementos de protección personal",
    "Uniformes hospitalarios",
  ],
};
---

<!doctype html>
<html lang="es" class="w-full">
  <head>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <!-- Production-only bootstrap: previews must not enter live analytics. -->
    <script is:inline>
      (() => {
        if (location.hostname !== "agenciasnacionales.com" || window.__agenciasAnalyticsReady) return;
        window.__agenciasAnalyticsReady = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        // astro:page-load owns page views; enhanced History API measurement is disabled.
        window.gtag("config", "G-VYZ3Q9LL82", { send_page_view: false });
        const tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=G-VYZ3Q9LL82";
        document.head.appendChild(tag);
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "y8116zylkc");
      })();
    </script>
    <script>
      import "../scripts/analytics";
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/avif" href="/Icon.avif?v=2" />
    <link rel="shortcut icon" href="/Icon.avif?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Agencias Nacionales S.A.S" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    <slot name="head" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="w-full bg-white text-gray-800 antialiased">
    <slot />
    {!hideWhatsApp && <WhatsAppFloat />}
    <script is:inline>
      (() => {
        const adjustHeaderOffset = () => {
          const header = document.querySelector("header");
          document.body.style.paddingTop = header ? `${header.offsetHeight}px` : "";
        };

        adjustHeaderOffset();
        window.addEventListener("resize", adjustHeaderOffset);
        document.addEventListener("astro:page-load", adjustHeaderOffset);
        document.addEventListener("astro:after-swap", adjustHeaderOffset);
        document.fonts?.ready.then(adjustHeaderOffset);
        const header = document.querySelector("header");
        if (header && !header.dataset.offsetObserved) {
          header.dataset.offsetObserved = "true";
          new ResizeObserver(adjustHeaderOffset).observe(header);
        }


      })();
    </script>
  </body>
</html>
