---
import logo from "../img/Logo.nav.avif";
import { categories, products, productHref } from "../data/catalog";
import p1 from "../img/Producto 1.avif";
import p2 from "../img/Producto 2.avif";
import p3 from "../img/Producto 3.avif";
import p4 from "../img/Producto 4.avif";
import p5 from "../img/Producto 5.avif";

const links = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Contacto", href: "/contacto" },
  { label: "FAQ", href: "/faq" },
  { label: "Blog", href: "/articulos" },
  { label: "Política ambiental", href: "/politica_ambiental" },
];

const searchSections = [
  {
    type: "Sección",
    title: "Productos",
    subtitle: "Catálogo completo",
    href: "/producto",
    keywords: ["productos", "catalogo", "catálogo", "todos"],
  },
  {
    type: "Sección",
    title: "Categorías",
    subtitle: "Explora las categorías",
    href: "/#categorias",
    keywords: ["categorias", "categoría", "categoria"],
  },
  {
    type: "Sección",
    title: "Nosotros",
    subtitle: "Conoce la empresa",
    href: "/nosotros",
    keywords: ["nosotros", "empresa", "quienes somos"],
  },
  {
    type: "Sección",
    title: "Contacto",
    subtitle: "Escríbenos para cotizar",
    href: "/contacto",
    keywords: ["contacto", "whatsapp", "cotizar"],
  },
  {
    type: "Sección",
    title: "FAQ",
    subtitle: "Preguntas frecuentes",
    href: "/faq",
    keywords: ["faq", "preguntas", "frecuentes"],
  },
  {
    type: "Sección",
    title: "Blog",
    subtitle: "Artículos y noticias",
    href: "/articulos",
    keywords: ["blog", "articulos", "noticias"],
  },
  {
    type: "Sección",
    title: "Política ambiental",
    subtitle: "Compromiso sostenible",
    href: "/politica_ambiental",
    keywords: ["ambiental", "sostenibilidad", "politica"],
  },
];

const searchIndex = [
  ...searchSections,
  ...categories.map((category) => ({
    type: "Categoría",
    title: category.label,
    subtitle: `${category.products.length} productos`,
    href: category.href,
    keywords: [category.label, ...category.products.slice(0, 6)],
  })),
  ...products.map((product) => ({
    type: "Producto",
    title: product.name,
    subtitle: product.category,
    href: productHref(product.name),
    keywords: [product.name, product.category],
  })),
];
---

<header
  transition:persist
  class="fixed top-0 z-50 w-full border-b border-gray-100 bg-white backdrop-blur"
>
  <nav
    class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8"
  >
    <a href="../" class="flex shrink-0 items-center">
      <img
        src={logo.src}
        alt="Agencias Nacionales S.A.S"
        width={logo.width}
        height={logo.height}
        decoding="async"
        class="h-20 w-auto"
      />
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-5 py-3 text-base font-bold text-gray-900 transition-all hover:bg-gray-200"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="hidden items-center gap-2 rounded-full border border-gray-200 bg-gray-200 px-16 py-2.5 text-m text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 lg:inline-flex"
        aria-label="Abrir búsqueda"
        aria-haspopup="dialog"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
        </svg>
        <span>Buscar</span>
      </button>

      <button
        type="button"
        data-search-open
        class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-gray-200 p-2.5 text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 lg:hidden"
        aria-label="Abrir búsqueda"
        aria-haspopup="dialog"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-md p-2 text-gray-600 lg:hidden"
        aria-label="Abrir menú"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="categories-nav" class="hidden border-t border-gray-100 lg:block">
    <nav class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ul class="flex items-center justify-between">
        {
          categories.map((category) => (
            <li class="mega-item static">
              <a
                href={category.href}
                class="flex items-center gap-1.5 py-3.5 text-m font-semibold text-black transition-colors"
              >
                {category.label}
                {category.featured && (
                  <svg
                    class="mega-chevron h-4 w-4 text-black transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                )}
              </a>

              {category.featured && (
                <div class="mega-drop absolute left-1/2 top-full z-40 w-screen pt-px">
                  <div class="mega-drop-inner border-y border-gray-100 bg-white p-6 shadow-2xl shadow-gray-200/60">
                    <div class="mx-auto grid max-w-7xl grid-cols-4 gap-6 px-4 sm:px-6 lg:px-8">
                      {category.featured.map((item) => (
                        <a
                          href={productHref(item.name)}
                          class="group/item flex flex-col"
                        >
                          {" "}
                          {/* 👈 */}
                          <div class="relative flex aspect-square items-center justify-center overflow-hidden rounded-xl bg-gray-50">
                            <img
                              src={item.image}
                              alt={item.name}
                              width="400"
                              height="400"
                              loading="lazy"
                              decoding="async"
                              class={`h-full w-full object-contain p-4 transition-opacity duration-200 ${item.image2 ? "group-hover/item:opacity-0" : ""}`}
                            />
                            {item.image2 && (
                              <img
                                src={item.image2}
                                alt={item.name}
                                width="400"
                                height="400"
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 h-full w-full object-contain p-4 opacity-0 transition-opacity duration-200 group-hover/item:opacity-100"
                              />
                            )}
                          </div>
                          <p class="mt-3 text-m font-medium text-gray-700 group-hover/item:text-blue-600">
                            {item.name}
                          </p>
                        </a>
                      ))}

                      <div class="border-l border-gray-100 pl-6">
                        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">
                          Productos
                        </p>
                        <ul class="mt-4 space-y-3">
                          {category.products.slice(0, 5).map((product) => (
                            <li>
                              <a
                                href={productHref(product)}
                                class="block text-m text-gray-600 transition-colors hover:text-blue-600"
                              >
                                {product}
                              </a>
                            </li>
                          ))}
                        </ul>
                        <a
                          href={category.href}
                          class="mt-5 inline-flex items-center gap-1 text-m font-semibold text-gray-900 transition-colors hover:text-blue-600"
                        >
                          Ver más
                          <svg
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 5l7 7-7 7"
                            />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Menú móvil: posición absoluta para flotar sobre el contenido -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden border-t border-gray-100 bg-white lg:hidden"
  >
    <div class="mobile-menu-inner">
      <div class="px-4 py-3">
        <button
          type="button"
          data-search-open
          class="flex w-full items-center gap-3 rounded-full border border-gray-200 bg-gray-50 px-4 py-3 text-left text-m text-gray-500 transition hover:border-gray-300 hover:bg-white"
        >
          <svg
            class="h-5 w-5 shrink-0 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
          </svg>
          <span>Buscar productos, categorías o secciones</span>
        </button>
      </div>

      <ul class="space-y-1 px-4 pb-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-blue-600"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="space-y-1 border-t border-gray-100 px-4 py-3">
        {
          categories.map((category) => (
            <li>
              <a
                href={category.href}
                class="block rounded-md px-3 py-2 text-base font-semibold text-gray-800 hover:bg-gray-50 hover:text-blue-600"
              >
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<div
  id="search-modal"
  class="search-modal hidden"
  aria-hidden="true"
>
  <button
    type="button"
    data-search-backdrop
    class="fixed inset-0 h-screen w-screen cursor-default bg-black/60 backdrop-blur-[2px]"
    aria-label="Cerrar búsqueda"
  ></button>

  <div class="pointer-events-none fixed inset-0 flex items-start justify-center px-4 pt-20 sm:pt-24">
    <div class="search-panel pointer-events-auto w-full max-w-2xl overflow-hidden rounded-[28px] bg-white shadow-2xl shadow-black/20 ring-1 ring-black/5">
      <div class="flex items-center gap-3 border-b border-gray-100 px-5 py-4">
        <svg
          class="h-5 w-5 shrink-0 text-gray-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Buscar productos, categorías o secciones"
          autocomplete="off"
          class="w-full border-0 bg-transparent text-base text-gray-800 outline-none placeholder:text-gray-400"
        />
        <button
          type="button"
          id="search-clear"
          class="hidden shrink-0 rounded-full bg-gray-100 px-2.5 py-1.5 text-xs font-semibold text-gray-500 transition hover:bg-gray-200"
        >
          Limpiar
        </button>
      </div>

      <div class="search-results-scroll max-h-[62vh] overflow-y-auto p-2">
        <div class="flex items-center justify-between px-3 py-2">
          <p id="search-hint" class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-400">
            Sugerencias
          </p>
        </div>
        <div id="search-results" class="space-y-1 pb-2"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .mega-item:hover .mega-chevron {
    transform: rotate(180deg);
  }

  /* Mega menú (hover en escritorio): despliegue tipo cortina, overlay sin empujar el body */
  .mega-drop {
    display: grid;
    grid-template-rows: 0fr;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition:
      grid-template-rows 520ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 360ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: grid-template-rows, opacity;
  }

  .mega-drop.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  /* Cambio directo entre categorías: sin animación de cortina (no sube/baja) */
  .mega-drop.no-anim {
    transition: none !important;
  }

  .mega-drop-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Animación de movimiento de los productos al cambiar de categoría */
  @keyframes mega-content-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mega-anim {
    animation: mega-content-in 380ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-anim {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-drop {
      transition: opacity 150ms ease;
    }
  }

  /* Menú móvil: posición absoluta para no desplazar el contenido de la página */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 49;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 520ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 360ms cubic-bezier(0.32, 0.72, 0, 1);
    opacity: 0;
    will-change: grid-template-rows, opacity;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .mobile-menu-inner {
    min-height: 0;
    overflow: hidden;
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .search-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-panel {
    transform: translateY(12px) scale(0.985);
    transition:
      transform 220ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 220ms ease;
  }

  .search-modal.is-open .search-panel {
    transform: translateY(0) scale(1);
  }

  .search-result-card {
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .search-result-card:hover {
    background: #f8fafc;
    transform: translateY(-1px);
  }

  .search-results-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .search-results-scroll::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }

    .search-modal,
    .search-panel,
    .search-result-card {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ searchIndex }}>
  (() => {
    const searchEmptyState = {
      title: "No encontramos resultados",
      subtitle: "Prueba con otro término o busca por categoría.",
      href: "/producto",
      type: "Sugerencia",
    };

    const initNavbar = () => {
      const normalized = (value) =>
        value
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim();

      const searchModal = document.getElementById("search-modal");
      const searchInput = document.getElementById("search-input");
      const searchResults = document.getElementById("search-results");
      const searchHint = document.getElementById("search-hint");
      const searchClear = document.getElementById("search-clear");
      const searchBackdrop = document.querySelector("[data-search-backdrop]");
      const searchTriggers = document.querySelectorAll("[data-search-open]");
      const menuToggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const categoriesNav = document.getElementById("categories-nav");

      if (!searchModal || !searchInput || !searchResults || !searchHint) {
        return;
      }

      window.__agenciasNavbarSearchController?.abort?.();
      const controller = new AbortController();
      window.__agenciasNavbarSearchController = controller;
      const { signal } = controller;

      const renderSearchResults = (query) => {
        const q = normalized(query || "");
        const ranked = searchIndex
          .map((item) => {
            const haystack = normalized(
              [item.title, item.subtitle, ...(item.keywords || [])].join(" "),
            );
            if (q && !haystack.includes(q)) return null;

            let score = 0;
            if (!q) {
              score = item.type === "Sección" ? 40 : item.type === "Categoría" ? 30 : 20;
            } else {
              if (normalized(item.title).startsWith(q)) score += 120;
              if (normalized(item.title).includes(q)) score += 70;
              if (normalized(item.subtitle).includes(q)) score += 25;
              if ((item.keywords || []).some((keyword) => normalized(keyword).includes(q))) {
                score += 20;
              }
              if (item.type === "Sección") score += 8;
            }
            return { ...item, score };
          })
          .filter(Boolean)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8);

        const items = ranked.length > 0 ? ranked : q ? [searchEmptyState] : [];

        searchResults.innerHTML = "";
        searchHint.textContent = q ? "Resultados" : "Sugerencias";

        if (q && ranked.length === 0) {
          const empty = document.createElement("div");
          empty.className =
            "mx-2 mb-2 rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-4 py-6 text-center";
          empty.innerHTML =
            `<p class="text-sm font-semibold text-gray-900">${searchEmptyState.title}</p>
           <p class="mt-1 text-sm text-gray-500">${searchEmptyState.subtitle}</p>`;
          searchResults.appendChild(empty);
          return;
        }

        items.forEach((item) => {
          const link = document.createElement("a");
          link.href = item.href;
          link.className =
            "search-result-card mx-2 flex items-center gap-4 rounded-2xl px-4 py-3 text-left";
          link.innerHTML = `
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gray-100 text-xs font-semibold uppercase tracking-widest text-gray-500">
            ${item.type.slice(0, 3)}
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-base font-semibold text-gray-900">${item.title}</p>
            <p class="mt-0.5 text-sm text-gray-500">${item.subtitle}</p>
          </div>
          <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        `;
          link.addEventListener("click", closeSearch, { signal });
          searchResults.appendChild(link);
        });
      };

      const openSearch = () => {
        searchModal.classList.remove("hidden");
        searchModal.classList.add("is-open");
        if (searchClear) {
          searchClear.classList.toggle(
            "hidden",
            searchInput.value.trim().length === 0,
          );
        }
        renderSearchResults(searchInput.value || "");
        window.setTimeout(() => searchInput.focus(), 30);
      };

      const closeSearch = () => {
        searchModal.classList.remove("is-open");
        window.setTimeout(() => {
          if (!searchModal.classList.contains("is-open")) {
            searchModal.classList.add("hidden");
          }
        }, 180);
      };

      const clearSearch = () => {
        searchInput.value = "";
        searchClear?.classList.add("hidden");
        renderSearchResults("");
        searchInput.focus();
      };

      searchTriggers.forEach((trigger) =>
        trigger.addEventListener("click", openSearch, { signal }),
      );
      searchBackdrop?.addEventListener("click", closeSearch, { signal });
      searchClear?.addEventListener("click", clearSearch, { signal });
      searchInput.addEventListener(
        "input",
        () => {
          searchClear?.classList.toggle("hidden", searchInput.value.trim().length === 0);
          renderSearchResults(searchInput.value);
        },
        { signal },
      );
      searchInput.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") closeSearch();
        },
        { signal },
      );
      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") closeSearch();
        },
        { signal },
      );

      if (menuToggle && mobileMenu) {
        let menuOpen = false;

        const openMenu = () => {
          menuOpen = true;
          mobileMenu.classList.remove("hidden");
          mobileMenu.style.display = "grid";
          mobileMenu.getBoundingClientRect();
          mobileMenu.classList.add("is-open");
        };

        const closeMenu = () => {
          menuOpen = false;
          mobileMenu.classList.remove("is-open");
        };

        mobileMenu.addEventListener(
          "transitionend",
          (e) => {
            if (e.propertyName === "grid-template-rows" && !menuOpen) {
              mobileMenu.style.display = "";
              mobileMenu.classList.add("hidden");
            }
          },
          { signal },
        );

        menuToggle.addEventListener(
          "click",
          () => {
            if (menuOpen) closeMenu();
            else openMenu();
          },
          { signal },
        );
      }

      if (categoriesNav) {
        const items = categoriesNav.querySelectorAll(".mega-item");
        let openDrop = null;
        let closeTimer = null;

        const animateContent = (drop) => {
          const inner = drop.querySelector(".mega-drop-inner > div");
          if (!inner) return;
          inner.classList.remove("mega-anim");
          void inner.offsetWidth;
          inner.classList.add("mega-anim");
        };

        const showDrop = (drop) => {
          drop.classList.add("is-open");
          drop.style.zIndex = "50";
          animateContent(drop);
        };

        const hideDrop = (drop) => {
          drop.classList.remove("is-open");
          drop.style.zIndex = "40";
        };

        const setOpenInstant = (drop, open) => {
          drop.classList.add("no-anim");
          drop.classList.toggle("is-open", open);
          drop.style.zIndex = open ? "50" : "40";
          drop.getBoundingClientRect();
          drop.classList.remove("no-anim");
        };

        const cancelClose = () => {
          if (closeTimer) {
            window.clearTimeout(closeTimer);
            closeTimer = null;
          }
        };

        const scheduleClose = () => {
          cancelClose();
          closeTimer = window.setTimeout(() => {
            if (openDrop) {
              hideDrop(openDrop);
              openDrop = null;
            }
          }, 120);
        };

        items.forEach((item) => {
          const drop = item.querySelector(".mega-drop");

          item.addEventListener(
            "mouseenter",
            () => {
              if (drop) {
                cancelClose();
                if (openDrop && openDrop !== drop) {
                  setOpenInstant(openDrop, false);
                  setOpenInstant(drop, true);
                  animateContent(drop);
                } else if (!openDrop) {
                  showDrop(drop);
                }
                openDrop = drop;
              } else if (openDrop) {
                hideDrop(openDrop);
                openDrop = null;
              }
            },
            { signal },
          );

          item.addEventListener("mouseleave", scheduleClose, { signal });

          drop?.addEventListener("mouseenter", cancelClose, { signal });
          drop?.addEventListener("mouseleave", scheduleClose, { signal });
        });
      }
    };

    initNavbar();

    if (!window.__agenciasNavbarSearchPageLoadBound) {
      window.__agenciasNavbarSearchPageLoadBound = true;
      document.addEventListener("astro:page-load", initNavbar);
    }
  })();
</script>
