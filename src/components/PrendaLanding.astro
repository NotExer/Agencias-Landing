---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import Banner from "./Banner.astro";
import ProductGrid from "./ProductGrid.astro";
import { products } from "../data/catalog";
import { waHref, YEARS_IN_BUSINESS } from "../data/contact";
import type { PrendaLandingData } from "../data/prendas";

interface Props {
  data: PrendaLandingData;
}

const { data } = Astro.props;
const canonicalUrl = `https://agenciasnacionales.com/${data.route}/`;
const quoteHref = waHref(data.quoteMessage);
const items = data.productNames
  .map((name) => products.find((p) => p.name === name))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: data.heading,
  serviceType: data.serviceType,
  url: canonicalUrl,
  provider: {
    "@id": "https://agenciasnacionales.com/#business",
    "@type": "LocalBusiness",
    name: "Agencias Nacionales S.A.S",
    url: "https://agenciasnacionales.com/",
  },
  areaServed: [
    { "@type": "City", name: "Medellín" },
    { "@type": "Country", name: "Colombia" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout title={data.title} description={data.description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Navbar />
  <main>
    <Banner
      image={data.heroImage}
      alt={data.heroAlt}
      eyebrow="Medellín, Valle de Aburrá y envíos a Colombia"
      heading={data.heading}
      description={data.heroDescription}
      headingLevel="h1"
      primaryAction={{ href: quoteHref, label: "Cotizar por WhatsApp", newTab: true }}
      secondaryAction={{ href: "/contacto/", label: "Enviar solicitud de cotización" }}
      secondaryActionStyle="outline"
    />

    <section class="w-full bg-white px-4 pb-5 sm:px-6 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-6 rounded-2xl border border-gray-100 bg-gray-50 px-6 py-7 text-sm text-gray-700 sm:grid-cols-3 sm:px-8">
        <p><strong class="block text-base text-slate-950">{items.length} referencias</strong> {data.statsLabel}</p>
        <p><strong class="block text-base text-slate-950">Sin pedido mínimo por producto</strong> Envíos con compra mínima de $500.000 en total.</p>
        <p><strong class="block text-base text-slate-950">{YEARS_IN_BUSINESS} años</strong> suministrando dotación a empresas.</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-m font-semibold text-blue-600">{data.usesEyebrow}</p>
        <h2 class="mt-2 text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">{data.usesHeading}</h2>
        <p class="mt-4 text-m leading-relaxed text-gray-500">
          {data.usesIntro} Para el resto de la dotación, revisa los
          <a href="/categoria/uniformes-de-trabajo/" class="font-semibold text-blue-600 underline hover:text-blue-700">uniformes de trabajo</a>
          y el
          <a href="/calzado-de-dotacion/" class="font-semibold text-blue-600 underline hover:text-blue-700">calzado de dotación</a>.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {data.uses.map((use) => (
          <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <h3 class="text-base font-bold text-gray-900">{use.title}</h3>
            <p class="mt-3 text-m leading-relaxed text-black">{use.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 lg:px-10">
      <h2 class="mb-8 text-2xl font-extrabold text-gray-900 sm:text-3xl">Referencias disponibles</h2>
      <ProductGrid products={items} />
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-m font-semibold text-blue-600">Preguntas frecuentes</p>
          <h2 class="mt-2 text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">Antes de cotizar</h2>
          <p class="mt-4 text-m leading-relaxed text-gray-500">
            ¿Necesitas también uniformes completos, calzado o EPP? Revisa nuestras
            <a href="/dotaciones-medellin/" class="font-semibold text-blue-600 underline hover:text-blue-700">dotaciones empresariales en Medellín</a>.
          </p>
          {data.siblings.length > 0 && (
            <p class="mt-3 text-m leading-relaxed text-gray-500">
              También:
              {data.siblings.map((s, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={s.href} class="font-semibold text-blue-600 underline hover:text-blue-700">{s.label}</a>
                </>
              ))}.
            </p>
          )}
        </div>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {data.faqs.map((faq) => (
            <details class="group py-5">
              <summary class="cursor-pointer list-none pr-8 text-base font-bold text-gray-900">{faq.question}</summary>
              <p class="mt-3 max-w-3xl text-m leading-relaxed text-gray-500">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 lg:px-10">
      <div class="rounded-2xl bg-blue-950 px-7 py-10 text-white sm:px-12 lg:flex lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">Cotiza la dotación de tu equipo</h2>
          <p class="mt-3 text-m leading-relaxed text-blue-100">Indica referencias, tallas, cantidades, personalización y ciudad de entrega. Te respondemos con disponibilidad y una cotización formal.</p>
        </div>
        <a
          href={quoteHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex rounded-full bg-white px-7 py-3.5 font-bold text-blue-800 transition hover:bg-blue-50 lg:mt-0"
        >
          Solicitar cotización por WhatsApp
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
