---
import { Image } from "astro:assets";
import { featuredArticles, getArticleImage, getArticlePath } from "../data/articles";
---

<section id="blog" class="w-full overflow-hidden bg-white px-8 py-16 sm:px-6 lg:px-20 xl:px-40">
  <div class="mx-auto w-full max-w-7xl">
    <div class="mb-[60px] text-center">
      <h2 class="text-[29px] font-bold leading-[1.6] text-black">
        Artículos destacados
      </h2>
    </div>

    <div class="hide-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto pb-8">
      {
        featuredArticles.map((post) => {
          const image = getArticleImage(post.slug);

          return (
            <a
              href={getArticlePath(post.slug)}
              class="relative aspect-[305/362] w-[85vw] flex-none snap-start overflow-hidden rounded-[20px] bg-gray-100 sm:w-[45vw] md:w-[30vw] lg:w-[23.828125%]"
            >
              {image ? (
                <Image
                  src={image}
                  alt={post.title}
                  widths={[480, 720]}
                  sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 23vw"
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <div class="absolute inset-0 bg-gray-100" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-[#111625] via-[#111625]/60 to-transparent opacity-90" />
              <div class="absolute inset-0 z-10 flex flex-col justify-end p-5 pb-[30px]">
                <span class="mb-[5px] text-base font-medium leading-[1.6] text-white">Tips</span>
                <h3 class="text-base font-bold leading-[1.6] text-white">{post.title}</h3>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
