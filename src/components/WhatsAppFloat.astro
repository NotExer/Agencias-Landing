---
import { waHref } from "../data/contact";

const href = waHref("Hola, quisiera más información sobre sus productos.");
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chatear por WhatsApp con Agencias Nacionales"
  transition:persist
  class="fixed bottom-4 right-4 z-[60] flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_6px_16px_rgba(0,0,0,0.14)] transition-transform duration-200 hover:scale-105 hover:bg-[#1ebe57] active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366] sm:bottom-5 sm:right-5 sm:h-14 sm:w-14"
>
  <svg
    class="h-6 w-6 fill-current sm:h-7 sm:w-7"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.5 1.34 5.02L2 22l5.13-1.35A9.96 9.96 0 0012.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10zm5.84 14.19c-.24.68-1.4 1.3-1.94 1.36-.5.06-1.11.08-1.79-.11-.41-.12-.94-.3-1.62-.58-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09.99-2.37.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.1.19-.15.31-.3.48-.15.17-.31.38-.44.51-.15.15-.31.31-.13.6.18.29.79 1.3 1.7 2.11 1.17 1.04 2.16 1.37 2.44 1.52.28.15.45.13.62-.08.17-.21.71-.83.9-1.11.19-.28.38-.24.64-.14.26.1 1.66.78 1.94.92.28.14.47.21.54.33.07.12.07.68-.17 1.36z"
    ></path>
  </svg>
</a>
