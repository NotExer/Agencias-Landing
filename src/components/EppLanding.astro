---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import Banner from "./Banner.astro";
import heroImage from "../img/Categoria epp apple.png";
import { waHref } from "../data/contact";

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  eyebrow: string;
  heading: string;
  intro: string;
  areaName: string;
  areaType: "City" | "Country";
  quoteMessage: string;
  coverageCopy: string;
  sectors: string[];
  faqs: Faq[];
}

const {
  title,
  description,
  canonicalUrl,
  eyebrow,
  heading,
  intro,
  areaName,
  areaType,
  quoteMessage,
  coverageCopy,
  sectors,
  faqs,
} = Astro.props;

const quoteHref = waHref(quoteMessage);
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: heading,
  serviceType: "Suministro de elementos de protección personal para empresas",
  url: canonicalUrl,
  provider: {
    "@type": "Organization",
    name: "Agencias Nacionales S.A.S",
    url: "https://agenciasnacionales.com/",
  },
  areaServed: {
    "@type": areaType,
    name: areaName,
  },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Navbar />
  <main>
    <Banner
      image={heroImage}
      alt="Elementos de protección personal para empresas"
      eyebrow={eyebrow}
      heading={heading}
      description={intro}
      headingLevel="h1"
      primaryAction={{ href: quoteHref, label: "Cotizar EPP por WhatsApp", newTab: true }}
      secondaryAction={{ href: "/categoria/epp/", label: "Ver catálogo de EPP" }}
      secondaryActionStyle="outline"
    />

    <section class="w-full bg-white px-4 pb-5 sm:px-6 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-6 rounded-2xl border border-gray-100 bg-gray-50 px-6 py-7 text-sm text-gray-700 sm:grid-cols-3 sm:px-8">
        <p><strong class="block text-base text-slate-950">Selección por riesgo</strong> El EPP debe responder a la labor y al peligro identificado.</p>
        <p><strong class="block text-base text-slate-950">Atención empresarial</strong> Consolidamos solicitudes por producto y cantidad.</p>
        <p><strong class="block text-base text-slate-950">Cobertura confirmada</strong> {coverageCopy}</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
      <div class="max-w-3xl">
        <p class="text-m font-semibold text-blue-600">Protección por parte del cuerpo</p>
        <h2 class="mt-2 text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">Organiza la compra de EPP por necesidad de protección</h2>
        <p class="mt-4 text-m leading-relaxed text-gray-500">La referencia correcta depende del riesgo, el tiempo de exposición, la compatibilidad con otros elementos y las condiciones reales del puesto.</p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:shadow-md"><h3 class="text-base font-bold text-gray-900">Cabeza y rostro</h3><p class="mt-3 text-m leading-relaxed text-black">Cascos, caretas y protección visual para impactos, partículas y tareas específicas.</p></div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:shadow-md"><h3 class="text-base font-bold text-gray-900">Oídos y respiración</h3><p class="mt-3 text-m leading-relaxed text-black">Protectores auditivos y respiradores seleccionados según la exposición del trabajador.</p></div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:shadow-md"><h3 class="text-base font-bold text-gray-900">Manos y cuerpo</h3><p class="mt-3 text-m leading-relaxed text-black">Guantes, prendas de alta visibilidad y protección para labores operativas.</p></div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:shadow-md"><h3 class="text-base font-bold text-gray-900">Pies</h3><p class="mt-3 text-m leading-relaxed text-black">Calzado de seguridad según el terreno, el riesgo eléctrico y las sustancias presentes.</p></div>
      </div>
      <a href="/categoria/epp/" class="mt-8 inline-flex rounded-full bg-blue-950 px-6 py-3 font-bold text-white transition hover:bg-blue-800">Consultar referencias de EPP</a>
    </section>

    <section class="w-full bg-white px-4 py-5 sm:px-6 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-12 rounded-2xl bg-gray-50 px-7 py-12 sm:px-10 lg:grid-cols-2 lg:px-12 lg:py-16">
        <div>
          <p class="text-m font-semibold text-blue-600">Información para cotizar</p>
          <h2 class="mt-2 text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">Evita comprar una referencia que no corresponde al riesgo</h2>
          <p class="mt-4 text-m leading-relaxed text-gray-500">Comparte la matriz de peligros, la ficha técnica o una descripción clara de la labor. También necesitamos cantidades, ciudad de entrega y cualquier requisito de marca o norma.</p>
          <a href="/articulos-del-blog/como-crear-matriz-reposicion-epp-por-cargo-consumo/" class="mt-5 inline-flex items-center gap-1 text-m font-semibold text-blue-600 transition hover:text-blue-700">Ver guía para organizar la reposición de EPP</a>
        </div>
          <ol class="space-y-4">
          <li class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><strong class="text-base text-gray-900">1. Identifica la labor y el peligro</strong><p class="mt-3 text-m leading-relaxed text-black">Describe el entorno, la exposición y la parte del cuerpo que debe protegerse.</p></li>
          <li class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><strong class="text-base text-gray-900">2. Define especificaciones y cantidades</strong><p class="mt-3 text-m leading-relaxed text-black">Incluye tallas, clases, materiales, normas solicitadas y consumo estimado.</p></li>
          <li class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><strong class="text-base text-gray-900">3. Confirma entrega y reposición</strong><p class="mt-3 text-m leading-relaxed text-black">Indica ciudad, fecha requerida y si necesitas separar el pedido por sede o área.</p></li>
        </ol>
      </div>
    </section>

    <section class="w-full bg-white px-4 py-5 sm:px-6 lg:px-10">
      <div class="mx-auto max-w-7xl rounded-2xl bg-blue-950 px-7 py-12 text-white sm:px-10 lg:px-12 lg:py-16">
        <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">EPP para distintos sectores</h2>
        <p class="mt-4 max-w-3xl text-m leading-relaxed text-gray-300">Cada sector tiene exposiciones diferentes. La solicitud debe especificar el cargo y la tarea, incluso cuando varios equipos usan la misma categoría de protección.</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {sectors.map((sector) => <li class="rounded-2xl bg-white/10 p-5 text-m font-semibold text-white">{sector}</li>)}
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-m font-semibold text-blue-600">Preguntas frecuentes</p>
          <h2 class="mt-2 text-3xl font-extrabold leading-tight text-gray-900 sm:text-4xl">Antes de cotizar EPP</h2>
        </div>
        <div class="flex flex-col gap-3">
          {faqs.map((faq) => (
            <div class="epp-faq-item rounded-xl border border-gray-100 bg-white p-5 shadow-sm transition hover:shadow-md">
              <button
                type="button"
                class="epp-faq-button flex w-full cursor-pointer items-center justify-between gap-1.5 text-left font-medium text-gray-900 outline-none"
                aria-expanded="false"
              >
                <h3 class="pr-4 text-m">{faq.question}</h3>
                <span class="relative h-5 w-5 shrink-0 text-gray-500">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="epp-faq-icon-closed absolute inset-0 h-5 w-5 opacity-100 transition-opacity duration-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="epp-faq-icon-opened absolute inset-0 h-5 w-5 opacity-0 transition-opacity duration-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
                  </svg>
                </span>
              </button>
              <div class="epp-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
                <div class="overflow-hidden">
                  <p class="pt-4 text-m leading-relaxed text-gray-600">{faq.answer}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 lg:px-10">
      <div class="rounded-2xl bg-blue-950 px-7 py-10 text-white sm:px-12 lg:flex lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">Solicita una cotización de EPP</h2>
          <p class="mt-3 text-m leading-relaxed text-blue-100">Comparte los elementos, cantidades, ciudad y condiciones de uso. Revisaremos la solicitud para orientarte sobre las opciones disponibles.</p>
        </div>
        <a href={quoteHref} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex rounded-full bg-white px-7 py-3.5 font-bold text-blue-800 transition hover:bg-blue-50 lg:mt-0">Cotizar elementos de protección</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initEppFaq() {
    const items = document.querySelectorAll<HTMLElement>(".epp-faq-item");

    items.forEach((item) => {
      const button = item.querySelector<HTMLButtonElement>(".epp-faq-button");
      const content = item.querySelector<HTMLElement>(".epp-faq-content");
      const closedIcon = item.querySelector<HTMLElement>(".epp-faq-icon-closed");
      const openedIcon = item.querySelector<HTMLElement>(".epp-faq-icon-opened");

      button?.addEventListener("click", () => {
        const isOpen = content?.classList.contains("grid-rows-[1fr]");

        items.forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.querySelector(".epp-faq-content")?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
            otherItem.querySelector(".epp-faq-icon-closed")?.classList.replace("opacity-0", "opacity-100");
            otherItem.querySelector(".epp-faq-icon-opened")?.classList.replace("opacity-100", "opacity-0");
            otherItem.querySelector<HTMLButtonElement>(".epp-faq-button")?.setAttribute("aria-expanded", "false");
          }
        });

        content?.classList.replace(isOpen ? "grid-rows-[1fr]" : "grid-rows-[0fr]", isOpen ? "grid-rows-[0fr]" : "grid-rows-[1fr]");
        closedIcon?.classList.replace(isOpen ? "opacity-0" : "opacity-100", isOpen ? "opacity-100" : "opacity-0");
        openedIcon?.classList.replace(isOpen ? "opacity-100" : "opacity-0", isOpen ? "opacity-0" : "opacity-100");
        button?.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  }

  document.addEventListener("astro:page-load", initEppFaq);
</script>
