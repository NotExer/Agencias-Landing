---
import { Image } from "astro:assets";
import { productHref, categorySlug, type Product } from "../data/catalog";

interface Props {
  products: Product[];
  id?: string;
}

const { products, id } = Astro.props;
---

<ul
  id={id}
  class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8"
>
  {
    products.map((product) => (
      <li class="product-item" data-category={categorySlug(product.category)}>
        <a href={productHref(product.name)} class="group flex flex-col">
          <div class="relative aspect-square w-full overflow-hidden rounded-2xl bg-gray-50">
            <Image
              widths={[224, 336, 448]}
              sizes="(min-width: 1024px) 280px, 224px"
              src={product.images[0]}
              alt={product.name}
              class:list={[
                "h-full w-full object-contain p-4 transition-opacity duration-200",
                product.images[1] && "group-hover:opacity-0",
              ]}
              loading="lazy"
              decoding="async"
            />
            {product.images[1] && (
              <Image
                widths={[224, 336, 448]}
                sizes="(min-width: 1024px) 280px, 224px"
                src={product.images[1]}
                alt={product.name}
                class="absolute inset-0 h-full w-full object-contain p-4 opacity-0 transition-opacity duration-200 group-hover:opacity-100"
                loading="lazy"
                decoding="async"
              />
            )}
            {!product.inStock && (
              <span class="absolute top-3 left-3 rounded-full bg-gray-800/70 px-2.5 py-1 text-[11px] font-medium text-white">
                Agotado
              </span>
            )}
          </div>
          <div class="mt-3 px-0.5">
            <p class="text-xs text-gray-500 mb-0.5">{product.category}</p>
            <p class="text-m font-medium text-gray-900 leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">
              {product.name}
            </p>
          </div>
        </a>
        <button
          type="button"
          data-add-to-cart
          data-slug={product.slug}
          data-name={product.name}
          data-image={product.images[0].src}
          disabled={!product.inStock}
          class="mt-3 flex w-full items-center justify-center gap-2 rounded-full bg-[#2B395E] px-4 py-2.5 text-m font-semibold text-white transition hover:bg-[#1E2843] disabled:cursor-not-allowed disabled:bg-gray-300"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272" />
          </svg>
          <span data-cart-button-label>{product.inStock ? "Agregar a cotización" : "Agotado"}</span>
        </button>
      </li>
    ))
  }
</ul>
