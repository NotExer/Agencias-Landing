---
import { Image, type ImageMetadata } from "astro:assets";

interface Action {
  href: string;
  label: string;
  newTab?: boolean;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  heading: string;
  description?: string;
  eyebrow?: string;
  headingLevel?: "h1" | "h2";
  primaryAction?: Action;
  secondaryAction?: Action;
  secondaryActionStyle?: "link" | "outline";
}

const {
  image,
  alt,
  heading,
  description,
  eyebrow,
  headingLevel = "h2",
  primaryAction,
  secondaryAction,
  secondaryActionStyle = "link",
} = Astro.props;

const headingClass = "text-3xl font-extrabold leading-tight text-white sm:text-4xl";
---

<section class="w-full sm:px-4 lg:px-6">
  <div class="relative mx-auto h-[450px] w-full overflow-hidden rounded-2xl bg-stone-800 shadow-xl md:h-[500px]">
    <Image
      src={image}
      alt={alt}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading={headingLevel === "h1" ? "eager" : "lazy"}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/15"></div>

    <div class="relative flex h-full w-full flex-col justify-center px-8 md:px-16">
      <div class="max-w-2xl">
        {eyebrow && (
          <p class="mb-2 text-m font-semibold text-blue-200">
            {eyebrow}
          </p>
        )}
        {
          headingLevel === "h1" ? (
            <h1 class={headingClass}>{heading}</h1>
          ) : (
            <h2 class={headingClass}>{heading}</h2>
          )
        }
        {description && <p class="mt-4 max-w-xl text-m leading-relaxed text-gray-200">{description}</p>}

        {(primaryAction || secondaryAction) && (
          <div class="mt-8 flex flex-wrap items-center gap-5 sm:gap-8">
            {
              primaryAction && (
                <a
                  href={primaryAction.href}
                  target={primaryAction.newTab ? "_blank" : undefined}
                  rel={primaryAction.newTab ? "noopener noreferrer" : undefined}
                  class="inline-flex rounded-full bg-blue-950 px-8 py-3.5 text-m font-semibold text-white shadow-lg transition-colors hover:bg-blue-800"
                >
                  {primaryAction.label}
                </a>
              )
            }
            {
              secondaryAction && secondaryActionStyle === "outline" && (
                <a
                  href={secondaryAction.href}
                  target={secondaryAction.newTab ? "_blank" : undefined}
                  rel={secondaryAction.newTab ? "noopener noreferrer" : undefined}
                  class="inline-flex rounded-full border border-white/50 px-7 py-3.5 text-m font-semibold text-white transition hover:bg-white/10"
                >
                  {secondaryAction.label}
                </a>
              )
            }
            {
              secondaryAction && secondaryActionStyle === "link" && (
                <a
                  href={secondaryAction.href}
                  target={secondaryAction.newTab ? "_blank" : undefined}
                  rel={secondaryAction.newTab ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 text-m font-bold text-white transition-colors hover:text-gray-300"
                >
                  {secondaryAction.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              )
            }
          </div>
        )}
      </div>
    </div>
  </div>
</section>
