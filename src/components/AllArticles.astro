---
import { Image } from "astro:assets";
import { articles, getArticleImage, getArticlePath, listedArticles } from "../data/articles";

const listedSlugs = new Set(listedArticles.map(({ slug }) => slug));
const allArticles = [
  ...listedArticles,
  ...articles.filter(({ slug }) => !listedSlugs.has(slug)),
];
const articlesPerPage = 6;
const articlePages = Array.from(
  { length: Math.ceil(allArticles.length / articlesPerPage) },
  (_, page) => allArticles.slice(page * articlesPerPage, (page + 1) * articlesPerPage),
);
---

<section id="todos-los-articulos" class="w-full bg-white px-8 py-16 sm:px-6 lg:px-20 xl:px-40">
  <div class="mx-auto w-full max-w-7xl">
    <div class="mb-[60px] text-center">
      <h2 class="text-[29px] font-bold leading-[1.6] text-black">Todos los artículos</h2>
    </div>

    <div data-articles-carousel class="relative" aria-roledescription="carrusel">
      <div class="overflow-hidden">
        <div data-carousel-track class="flex transition-transform duration-500 ease-out">
          {
            articlePages.map((page, pageIndex) => (
              <div
                data-carousel-slide
                class="w-full flex-none"
                aria-hidden={pageIndex === 0 ? "false" : "true"}
              >
                <div class="grid grid-cols-1 gap-x-[30px] gap-y-10 md:grid-cols-2">
                  {page.map((article) => {
                    const image = getArticleImage(article.slug);

                    return (
                      <a
                        href={getArticlePath(article.slug)}
                        class="grid min-w-0 grid-cols-1 gap-5 sm:grid-cols-[minmax(0,0.95fr)_minmax(0,1fr)]"
                      >
                        <div class="aspect-video w-full overflow-hidden rounded-[10px] bg-gray-100">
                          {image ? (
                            <Image
                              src={image}
                              alt={article.title}
                              widths={[480, 720, 960]}
                              sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 295px"
                              loading="lazy"
                              class="h-full w-full object-cover"
                            />
                          ) : (
                            <div class="h-full w-full bg-gray-100" />
                          )}
                        </div>
                        <div class="flex min-w-0 flex-col">
                          <div class="mb-[10px] flex min-h-[38px] items-center justify-between gap-3">
                            <span class="rounded-full bg-[#ebebeb] px-[15px] py-2 text-sm font-normal leading-[1.6] text-black">Tips</span>
                            <time datetime={article.dateISO} class="text-sm font-normal leading-[1.6] text-[#888888]">{article.date}</time>
                          </div>
                          <h3 class="text-xl font-medium leading-[1.6] text-[#666666]">{article.title}</h3>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-12 flex items-center justify-center gap-5">
        <button
          type="button"
          data-carousel-previous
          class="flex h-11 w-11 items-center justify-center rounded-full border border-[#d7d7d7] bg-white text-black transition-colors hover:bg-[#ebebeb] disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Ver artículos anteriores"
          disabled
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <span data-carousel-status class="min-w-12 text-center text-sm text-[#666666]" aria-live="polite">
          1 / {articlePages.length}
        </span>

        <button
          type="button"
          data-carousel-next
          class="flex h-11 w-11 items-center justify-center rounded-full border border-[#d7d7d7] bg-white text-black transition-colors hover:bg-[#ebebeb] disabled:cursor-not-allowed disabled:opacity-35"
          aria-label="Ver más artículos"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function initializeArticleCarousels() {
    document.querySelectorAll<HTMLElement>("[data-articles-carousel]").forEach((carousel) => {
      if (carousel.dataset.initialized === "true") return;

      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
      const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-previous]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");

      if (!track || !previous || !next || !status || slides.length === 0) return;

      carousel.dataset.initialized = "true";
      let currentPage = 0;

      const updateCarousel = () => {
        track.style.transform = `translate3d(-${currentPage * 100}%, 0, 0)`;
        previous.disabled = currentPage === 0;
        next.disabled = currentPage === slides.length - 1;
        status.textContent = `${currentPage + 1} / ${slides.length}`;

        slides.forEach((slide, index) => {
          const isCurrent = index === currentPage;
          slide.setAttribute("aria-hidden", String(!isCurrent));
          slide.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
            if (isCurrent) link.removeAttribute("tabindex");
            else link.tabIndex = -1;
          });
        });
      };

      previous.addEventListener("click", () => {
        if (currentPage === 0) return;
        currentPage -= 1;
        updateCarousel();
      });

      next.addEventListener("click", () => {
        if (currentPage === slides.length - 1) return;
        currentPage += 1;
        updateCarousel();
      });

      carousel.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") previous.click();
        if (event.key === "ArrowRight") next.click();
      });

      updateCarousel();
    });
  }

  initializeArticleCarousels();
  document.addEventListener("astro:page-load", initializeArticleCarousels);
</script>
