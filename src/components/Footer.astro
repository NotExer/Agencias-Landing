---
import logo from "../img/Icono footer.png";
import { categories, categorySlug } from "../data/catalog";
import { waHref } from "../data/contact";
---

<footer class="w-full px-1 sm:px-5 lg:px-10 xl:px-10 bg-white pb-5">
  <div
    class="relative w-full rounded-[32px] bg-[#1a1c1d] mx-auto px-8 md:px-16 py-10"
  >
    <!-- Top Section: Newsletter -->
    <div
      class="flex flex-col lg:flex-row justify-between items-center gap-6 mb-10"
    >
      <div class="w-full lg:w-1/2">
        <h2
          class="text-xl md:text-[24px] font-semibold text-white leading-tight max-w-[500px]"
        >
          Recibe las mejores ofertas y novedades antes que nadie
        </h2>
      </div>
      <div class="w-full lg:w-1/2 max-w-[550px]">
        <p class="text-sm text-white mb-4 leading-relaxed">
          Suscríbete a nuestro boletín y mantente al día con promociones
          exclusivas, nuevos lanzamientos y contenido útil para tu negocio.
        </p>
        <form
          class="flex w-full max-w-full items-center bg-white rounded-full overflow-hidden p-1"
        >
          <input
            type="email"
            placeholder="nombre@gmail.com"
            class="w-full min-w-0 flex-1 bg-transparent px-3 sm:px-4 py-2 outline-none text-gray-800 text-sm sm:text-sm"
            required
          />
          <button
            type="submit"
            class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 sm:px-6 py-2 sm:py-2.5 rounded-full transition-colors text-sm sm:text-sm"
          >
            Suscribirme
          </button>
        </form>
      </div>
    </div>

    <!-- Middle Section: Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-8">
      <!-- Logo & Description (takes 2 columns on lg) -->
      <div class="lg:col-span-2">
        <!-- Logo en escala de grises con brillo para parecer blanco (si el original es oscuro) o normal -->
        <img
          src={logo.src}
          alt="Agencias Nacionales S.A.S"
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
          class="h-14 w-auto mb-4 backdrop-blur-sm"
        />
        <p class="text-sm leading-relaxed text-gray-400 max-w-[300px]">
          Fabricamos uniformes y calzado de trabajo con calidad, seguridad y
          sostenibilidad, adaptados a las necesidades de cada cliente.
        </p>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="text-sm font-bold text-white mb-4">Navegación</h3>
        <ul class="space-y-2">
          {
            [
              { label: "Nosotros", href: "/nosotros" },
              { label: "Contacto", href: "/contacto" },
              { label: "FAQ", href: "/faq" },
              { label: "Blog", href: "/articulos" },
              { label: "Política ambiental", href: "/politica_ambiental" },
              { label: "Política de seguridad", href: "/politica_seguridad" },
              { label: "Política de calidad", href: "/politica_calidad" },
              { label: "Política de privacidad", href: "/politica_privacidad" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-white text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Comprar -->
      <div>
        <h3 class="text-sm font-bold text-white mb-4">Comprar</h3>
        <ul class="space-y-2">
          {
            [
              { label: "Todos los productos", href: "/producto" },
              ...categories.map((c) => ({
                label: c.label,
                href: `/categoria/${categorySlug(c.label)}`,
              })),
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-white text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-bold text-white mb-4">Contacto</h3>
        <ul class="space-y-2">
          <li>
            <a
              href={waHref("Hola, quisiera más información sobre sus productos.")}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-white text-sm transition-colors"
              >WhatsApp</a
            >
          </li>
          <li>
            <a
              href="mailto:contactanos@agenciasnacionales.com"
              class="text-gray-400 hover:text-white text-sm transition-colors"
              >contactanos@agenciasnacionales.com</a
            >
          </li>
          <li>
            <a
              href="tel:3042351036"
              class="text-gray-400 hover:text-white text-sm transition-colors"
              >304 2351036</a
            >
          </li>
          <li><span class="text-gray-400 text-sm">(604) 322 2292</span></li>
          <li>
            <span
              class="text-gray-400 hover:text-white text-sm transition-colors"
              >Agencias Nacionales SAS. Carrera, 47 20 Sur Zona 2, Envigado,
              Antioquia</span
            >
          </li>
        </ul>

        <div class="flex gap-4 mt-4">
          <a
            href="https://www.instagram.com/agencias_nacionales"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-gray-400 hover:text-white transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/agencias-nacionales/posts/?feedView=all"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-400 hover:text-white transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=61566851084986"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-gray-400 hover:text-white transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-4 pt-5 border-t border-gray-800 text-xs"
    >
      <p class="text-[#3b82f6]">
        © Agencias Nacionales 2026. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="/politica_privacidad" class="text-[#3b82f6] hover:text-blue-400 transition-colors"
          >Política de privacidad</a
        >
        <a href="/politica_uso" class="text-[#3b82f6] hover:text-blue-400 transition-colors"
          >Términos de uso</a
        >
      </div>
    </div>
  </div>
</footer>
