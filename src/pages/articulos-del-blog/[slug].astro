---
import { SEO_METADATA } from "../../data/seo";
import { Image } from "astro:assets";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import missionPymeAvatar from "../../img/blog/author-misionpyme.jpg";
import {
  articles,
  getArticleCluster,
  getArticleImage,
  getArticlePath,
  type Article,
  type ArticleBlock,
} from "../../data/articles";
import Layout from "../../layouts/Layout.astro";
import { waHref } from "../../data/contact";
import { getArticleExtras } from "../../data/article-extras";

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const heroImage = getArticleImage(article.slug);
const canonicalUrl = `https://agenciasnacionales.com${getArticlePath(article.slug)}`;
type ContentGroup = ArticleBlock | { type: "ul"; items: string[] };
const contentGroups: ContentGroup[] = [];

for (const block of article.blocks) {
  if (block.type !== "li") {
    contentGroups.push(block);
    continue;
  }

  const previous = contentGroups.at(-1);
  if (previous?.type === "ul") {
    previous.items.push(block.text);
  } else {
    contentGroups.push({ type: "ul", items: [block.text] });
  }
}

const cluster = getArticleCluster(article.slug);
const clusterLinkIndex = contentGroups.findIndex((block) => block.type === "p");
const hasMissionPymeAvatar = article.author === "MisiónPyme";
const extras = getArticleExtras(article.slug);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: SEO_METADATA[getArticlePath(article.slug)]?.description ?? article.description,
  image: heroImage ? new URL(heroImage.src, Astro.site).href : undefined,
  datePublished: article.dateISO,
  dateModified: extras?.updatedISO ?? article.dateISO,
  mainEntityOfPage: canonicalUrl,
  author: {
    "@type": "Organization",
    name: article.author || "Agencias Nacionales",
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://agenciasnacionales.com/#business",
    name: "Agencias Nacionales S.A.S",
  },
};
const faqSchema = extras?.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: extras.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    }
  : undefined;
---

<Layout
  title={`${article.title} | Agencias Nacionales`}
  description={article.description}
  image={heroImage?.src}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={article.dateISO} />
    {extras?.updatedISO && <meta property="article:modified_time" content={extras.updatedISO} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <Navbar />

  <main class="bg-white px-[15px] pb-24 pt-16 sm:px-[30px] lg:pt-20">
    <header class="mx-auto max-w-[1000px]">
      <span class="inline-flex rounded-full bg-[#ebebeb] px-[15px] py-2 text-lg font-normal leading-[1.6] text-black">
        {article.tag}
      </span>
      <h1 class="mt-5 text-[34px] font-bold leading-[1.3] text-black sm:text-[40px]">
        {article.title}
      </h1>
      <div class="mt-5 flex items-center justify-between gap-5 text-lg font-normal leading-[1.6] text-black">
        {
          article.author ? (
            <div class="flex items-center gap-3">
              {hasMissionPymeAvatar ? (
                <Image
                  src={missionPymeAvatar}
                  alt="MisiónPyme"
                  width={40}
                  height={40}
                  class="h-10 w-10 rounded-full border border-blue-500 object-cover"
                />
              ) : (
                <img
                  src="/apple-touch-icon.png"
                  alt="Agencias Nacionales"
                  width="40"
                  height="40"
                  class="h-10 w-10 rounded-full border border-gray-200 object-cover"
                />
              )}
              <span>{article.author}</span>
            </div>
          ) : (
            <span />
          )
        }
        {
          extras?.updatedISO ? (
            <span class="shrink-0">
              Actualizado: <time datetime={extras.updatedISO}>{extras.updatedLabel ?? extras.updatedISO}</time>
            </span>
          ) : (
            <time datetime={article.dateISO} class="shrink-0">{article.date}</time>
          )
        }
      </div>
    </header>

    <div class="mx-auto mt-[70px] max-w-[1000px]">
      <div class="aspect-[5/2] overflow-hidden rounded-[20px] bg-gray-100">
        {
          heroImage ? (
            <Image
              src={heroImage}
              alt={article.title}
              widths={[720, 1080, 1440]}
              sizes="(max-width: 1060px) calc(100vw - 30px), 1000px"
              class="h-full w-full object-cover"
              loading="eager"
            />
          ) : (
            <div class="h-full w-full bg-gray-100" />
          )
        }
      </div>
    </div>

    <article class="article-body mx-auto max-w-[800px] pt-16 lg:pt-20">
        {
          extras?.summary?.length && (
            <section class="answer-box" aria-labelledby="respuesta-corta" data-answer-box>
              <h2 id="respuesta-corta">{extras.summaryHeading ?? "Respuesta corta"}</h2>
              <ul>
                {extras.summary.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }
        {
          contentGroups.map((block, index) => {
            if (block.type === "h2") return <h2>{block.text}</h2>;
            if (block.type === "h3") return <h3>{block.text}</h3>;
            if (block.type === "ul") {
              return <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
            }
            if (index === clusterLinkIndex) {
              return (
                <>
                  <p>{block.text}</p>
                  <p class="cluster-link">
                    {cluster.lead} <a href={cluster.href}>{cluster.anchor}</a>.
                  </p>
                </>
              );
            }
            return <p>{block.text}</p>;
          })
        }
        {
          extras?.faqs?.length && (
            <section class="article-faq" aria-labelledby="preguntas-frecuentes">
              <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
              {extras.faqs.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </section>
          )
        }
    </article>

    {
      extras?.cta && (
        <section class="mx-auto mt-16 max-w-[800px] rounded-3xl border-2 border-blue-700 bg-blue-50 px-7 py-9 sm:px-10" data-seasonal-cta>
          <h2 class="text-2xl font-bold text-slate-950">{extras.cta.heading}</h2>
          <p class="mt-3 leading-7 text-slate-700">{extras.cta.text}</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href={waHref(extras.cta.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex rounded-full bg-blue-800 px-6 py-3 font-bold text-white transition hover:bg-blue-900"
            >
              {extras.cta.label}
            </a>
            {extras.cta.secondaryHref && (
              <a href={extras.cta.secondaryHref} class="font-semibold text-blue-800 underline underline-offset-4">
                {extras.cta.secondaryLabel}
              </a>
            )}
          </div>
        </section>
      )
    }

    <aside class="mx-auto mt-16 max-w-[800px] rounded-3xl bg-slate-950 px-7 py-9 text-white sm:px-10">
      <h2 class="text-2xl font-bold">Lleva esta guía a una cotización real</h2>
      <p class="mt-3 leading-7 text-slate-300">
        Comparte productos, cantidades y ciudades. Te ayudamos a organizar la solicitud para tu empresa.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-blue-200">
        <a href="/dotaciones-medellin/" class="hover:text-white">Dotaciones en Medellín</a>
        <a href="/dotaciones-empresariales-colombia/" class="hover:text-white">Dotaciones en Colombia</a>
        <a href="/categoria/calzado-de-trabajo/" class="hover:text-white">Calzado de trabajo</a>
        <a href="/epp-medellin/" class="hover:text-white">EPP en Medellín</a>
      </div>
      <a
        href={waHref(`Hola, leí el artículo "${article.title}" y quiero cotizar para mi empresa.`)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex rounded-full bg-blue-950 px-6 py-3 font-bold text-white transition hover:bg-blue-800"
      >
        Solicitar cotización
      </a>
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  .article-body {
    color: #000;
    font-size: 1rem;
    line-height: 1.6;
  }

  .article-body :global(h2) {
    margin: 3rem 0 1.25rem;
    color: #666;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .article-body :global(h3) {
    margin: 3rem 0 1.25rem;
    color: #666;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .article-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-body .cluster-link {
    border-left: 3px solid #1e40af;
    padding-left: 1rem;
  }

  .article-body .cluster-link a {
    color: #1d4ed8;
    font-weight: 600;
    text-decoration: underline;
  }

  .article-body .answer-box {
    margin: 0 0 2.5rem;
    border-radius: 1rem;
    background: #f1f5f9;
    padding: 1.5rem 1.75rem;
  }

  .article-body .answer-box h2 {
    margin: 0 0 0.75rem;
    color: #0f172a;
    font-weight: 700;
  }

  .article-body .answer-box ul {
    margin: 0;
  }

  .article-body .article-faq details {
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 0;
  }

  .article-body .article-faq summary {
    cursor: pointer;
    font-weight: 700;
  }

  .article-body .article-faq details p {
    margin: 0.75rem 0 0;
  }

  .article-body :global(ul) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .article-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .article-body :global(h2:first-child),
  .article-body :global(h3:first-child) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .article-body :global(h2),
    .article-body :global(h3) {
      font-size: 1.125rem;
    }
  }
</style>
