---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProductDetail from "../../components/ProductDetail.astro";
import RelatedCategory from "../../components/RelatedCategory.astro";
import MoreProducts from "../../components/MoreProducts.astro";
import Benefits from "../../components/Benefits.astro";
import { products } from "../../data/catalog";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;

function buildWhatsAppHref(productName: string) {
  const params = new URLSearchParams({
    phone: "573042351036",
    text: `Hola, me interesa el producto "${productName}". ¿Me pueden cotizar?`,
    type: "phone_number",
    app_absent: "0",
  });

  return `https://api.whatsapp.com/send/?${params.toString()}`;
}
---

<Layout title={`${product.name} | Agencias Nacionales S.A.S`}>
  <Navbar />
  <main class="w-full bg-white">
    <ProductDetail
      name={product.name}
      images={product.images}
      highlights={product.highlights}
      description={product.description}
      inStock={product.inStock}
      contactHref={buildWhatsAppHref(product.name)}
      info={product.info}
    />
    <RelatedCategory currentSlug={product.slug} category={product.category} />
    <MoreProducts currentSlug={product.slug} category={product.category} />
  </main>
  <Benefits />
  <Footer />
</Layout>
