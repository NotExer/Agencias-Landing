---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProductDetail from "../../components/ProductDetail.astro";
import RelatedCategory from "../../components/RelatedCategory.astro";
import MoreProducts from "../../components/MoreProducts.astro";
import Benefits from "../../components/Benefits.astro";
import { products, categorySlug } from "../../data/catalog";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;

const raw = product.description.join(" ").replace(/\s+/g, " ").trim();
const description = raw.length > 158 ? raw.slice(0, 155).trimEnd() + "…" : raw;

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: raw,
  image: product.images.map((i) => new URL(i.src, Astro.site).href),
  category: product.category,
  brand: { "@type": "Brand", name: "Agencias Nacionales S.A.S" },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Productos", item: new URL("/producto/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 3,
      name: product.category,
      item: new URL(`/categoria/${categorySlug(product.category)}/`, Astro.site).href,
    },
    { "@type": "ListItem", position: 4, name: product.name },
  ],
};
---

<Layout
  title={`${product.name} | Agencias Nacionales S.A.S`}
  description={description}
  image={product.images[0]?.src}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <Navbar />
  <main class="w-full bg-white">
    <ProductDetail
      name={product.name}
      images={product.images}
      highlights={product.highlights}
      description={product.description}
      inStock={product.inStock}
      contactHref="/contacto/"
      info={product.info}
    />
    <RelatedCategory currentSlug={product.slug} category={product.category} />
    <MoreProducts currentSlug={product.slug} category={product.category} />
  </main>
  <Benefits />
  <Footer />
</Layout>
