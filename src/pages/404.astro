---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import error404Image from "../img/404-error.webp";
---

<Layout
  title="Página no encontrada | Agencias Nacionales S.A.S"
  description="La página que buscas no existe o fue movida. Vuelve al inicio o explora nuestro blog y catálogo."
  image={error404Image.src}
  noindex={true}
  hideWhatsApp={true}
>
  <Navbar />
  <main class="overflow-hidden bg-white">
    <section class="relative px-4 py-16 sm:px-6 lg:px-8 lg:py-0">
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="order-2 lg:order-1">
          <span class="inline-flex rounded-full bg-[#ebebeb] px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-black">
            Error 404
          </span>
          <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-tight text-black sm:text-5xl lg:text-6xl">
            No encontramos esta página.
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-8 text-[#666666]">
            La URL que abriste no existe, cambió de dirección o fue escrita con un error.
            Puedes volver al inicio, explorar el blog o revisar nuestros productos.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-full bg-black px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#333333]"
            >
              Volver al inicio
            </a>
            <a
              href="/articulos"
              class="inline-flex items-center justify-center rounded-full border border-[#d7d7d7] bg-white px-6 py-3 text-sm font-semibold text-black transition-colors hover:bg-[#f3f4f6]"
            >
              Ir al blog
            </a>
            <a
              href="/producto"
              class="inline-flex items-center justify-center rounded-full border border-transparent bg-[#ebebeb] px-6 py-3 text-sm font-semibold text-black transition-colors hover:bg-[#dedede]"
            >
              Ver productos
            </a>
          </div>

          <div class="mt-10 grid max-w-2xl gap-4 rounded-[28px] border border-[#ececec] bg-[#fafafa] p-6 sm:grid-cols-3">
            <div>
              <p class="text-sm font-semibold text-black">¿Qué pasó?</p>
              <p class="mt-2 text-sm leading-6 text-[#666666]">
                Puede ser un enlace roto, una página eliminada o una dirección incorrecta.
              </p>
            </div>
            <div>
              <p class="text-sm font-semibold text-black">¿Qué puedes hacer?</p>
              <p class="mt-2 text-sm leading-6 text-[#666666]">
                Usa los botones de arriba para regresar a una sección útil del sitio.
              </p>
            </div>
            <div>
              <p class="text-sm font-semibold text-black">¿Necesitas ayuda?</p>
              <p class="mt-2 text-sm leading-6 text-[#666666]">
                Contáctanos y te guiamos para encontrar la información correcta.
              </p>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="overflow-hidden rounded-[32px] border border-[#ececec] bg-[#f7f7f7] shadow-[0_24px_80px_rgba(0,0,0,0.08)]">
            <div class="aspect-[4/3] w-full">
              <Image
                src={error404Image}
                alt="Ilustración de error 404 en un entorno industrial"
                widths={[720, 1080, 1440]}
                sizes="(max-width: 1024px) calc(100vw - 2rem), 560px"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
