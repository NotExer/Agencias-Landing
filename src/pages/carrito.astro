---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Carrito de cotizaciones | Agencias Nacionales S.A.S"
  description="Revisa los productos seleccionados y solicita una cotización a Agencias Nacionales."
  noindex
>
  <Navbar />
  <main class="min-h-screen w-full bg-white">
    <section class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-2 border-b border-gray-100 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-m font-semibold text-blue-600">Carrito de cotizaciones</p>
          <h1 class="mt-1 text-2xl font-extrabold text-gray-900 sm:text-3xl">
            Productos seleccionados
          </h1>
          <p class="mt-2 text-m text-gray-500">
            Revisa las referencias y envía la lista para conocer su precio.
          </p>
        </div>
        <p id="cart-page-count" class="text-m font-medium text-gray-500" aria-live="polite">
          0 productos
        </p>
      </div>

      <div id="cart-page-empty" class="py-20 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-100">
          <svg class="h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272" />
          </svg>
        </div>
        <p class="text-m font-semibold text-gray-700">Tu carrito de cotizaciones está vacío</p>
        <p class="mt-1 text-m text-gray-400">Agrega productos del catálogo para preparar tu solicitud.</p>
        <a href="/producto/" class="mt-5 inline-flex rounded-full bg-[#2B395E] px-5 py-3 text-m font-medium text-white transition hover:bg-[#1E2843]">
          Ver productos
        </a>
      </div>

      <div id="cart-page-content" class="hidden grid-cols-1 gap-8 py-8 lg:grid-cols-[1fr_360px]">
        <ul id="cart-page-list" class="divide-y divide-gray-100 rounded-2xl border border-gray-100 bg-white"></ul>

        <aside class="h-fit rounded-2xl border border-gray-100 bg-gray-50 p-5 lg:sticky lg:top-32">
          <h2 class="text-lg font-bold text-gray-900">Resumen</h2>
          <div class="mt-5 space-y-3">
            <div class="flex items-center justify-between text-m">
              <span class="text-gray-500">Referencias seleccionadas</span>
              <span id="cart-page-items" class="font-semibold text-gray-900">0</span>
            </div>
          </div>
          <p class="mt-3 text-xs leading-relaxed text-gray-500">
            Enviaremos la disponibilidad y el valor de las referencias seleccionadas.
          </p>
          <a
            id="cart-page-quote"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 flex w-full items-center justify-center rounded-full bg-green-600 px-5 py-3.5 text-center text-m font-semibold text-white transition hover:bg-green-700"
          >
            Solicitar cotización por WhatsApp
          </a>
          <button id="cart-page-clear" type="button" class="mt-3 w-full py-2 text-xs text-gray-400 transition hover:text-red-500">
            Vaciar carrito
          </button>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import {
    clearCart,
    getCart,
    getCount,
    removeFromCart,
  } from "../scripts/cart";
  import { WHATSAPP_NUMBER } from "../data/contact";

  declare global {
    interface Window {
      __agenciasCartPageBound?: boolean;
    }
  }

  const escapeHtml = (value: string) =>
    value.replace(/[&<>'"]/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "'": "&#39;",
        '"': "&quot;",
      };
      return entities[character];
    });

  function renderCartPage() {
    const items = getCart();
    const count = getCount();
    const empty = document.getElementById("cart-page-empty");
    const content = document.getElementById("cart-page-content");
    const list = document.getElementById("cart-page-list");
    const countLabel = document.getElementById("cart-page-count");
    const itemCount = document.getElementById("cart-page-items");
    const quoteLink = document.getElementById("cart-page-quote") as HTMLAnchorElement | null;

    if (!empty || !content || !list || !countLabel || !itemCount || !quoteLink) return;

    const hasItems = items.length > 0;
    empty.classList.toggle("hidden", hasItems);
    content.classList.toggle("hidden", !hasItems);
    content.classList.toggle("grid", hasItems);
    countLabel.textContent = `${count} ${count === 1 ? "producto" : "productos"}`;
    itemCount.textContent = String(count);

    list.innerHTML = items
      .map((item) => {
        const slug = escapeHtml(item.slug);
        const name = escapeHtml(item.name);
        const image = escapeHtml(item.image);
        return `
          <li class="flex flex-col gap-4 p-4 sm:flex-row sm:items-center">
            <img src="${image}" alt="${name}" class="h-24 w-24 rounded-xl bg-gray-50 object-contain p-2" loading="lazy" decoding="async" />
            <div class="min-w-0 flex-1">
              <a href="/producto/${slug}/" class="text-m font-bold leading-snug text-gray-900 hover:text-blue-600">${name}</a>
              <div class="mt-3 flex items-center gap-2">
                <button type="button" class="cart-page-remove text-xs font-medium text-gray-400 transition hover:text-red-500" data-slug="${slug}">Eliminar de la cotización</button>
              </div>
            </div>
          </li>`;
      })
      .join("");

    const message = [
      "Hola, quisiera cotizar estos productos:",
      "",
      ...items.map((item) => `• ${item.name}`),
      "",
      "¿Me pueden confirmar disponibilidad, precio y condiciones de entrega?",
    ].join("\n");
    quoteLink.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  }

  const initCartPage = () => {
    const list = document.getElementById("cart-page-list");
    if (!list || list.dataset.initialized === "true") {
      renderCartPage();
      return;
    }

    list.dataset.initialized = "true";
    list.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const removeButton = target.closest<HTMLElement>(".cart-page-remove");
      if (removeButton?.dataset.slug) removeFromCart(removeButton.dataset.slug);
    });

    document.getElementById("cart-page-clear")?.addEventListener("click", clearCart);
    if (!window.__agenciasCartPageBound) {
      window.__agenciasCartPageBound = true;
      window.addEventListener("cart:updated", renderCartPage);
    }
    renderCartPage();
  };

  document.addEventListener("astro:page-load", initCartPage);
  initCartPage();
</script>
